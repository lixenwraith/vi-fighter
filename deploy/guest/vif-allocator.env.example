# Site values for vif-allocator.service. Install as
# /etc/vif-allocator/allocator.env and keep the image equal to an image listed by
# `sudo k3s crictl images`.
VIF_ALLOCATOR_LISTEN=:9080
VIF_ALLOCATOR_IMAGE=docker.io/library/vi-fighter:CHANGE_ME
VIF_ALLOCATOR_JOIN_HOST=CHANGE_ME
VIF_ALLOCATOR_PAGE_BASE=https://CHANGE_ME/projects/vi-fighter/session/
VIF_ALLOCATOR_LOG_STREAM_URL=http://127.0.0.1:8081/stream
# What a caller may select per session. The ceiling is the default roster until it is
# raised here; trace stays out of reach because the fleet's log rate and tmpfs are
# shared and an anonymous request must not raise either.
VIF_ALLOCATOR_PLAYERS_MAX=4
VIF_ALLOCATOR_LOG_LEVEL_MIN=debug
# The scenario every session gets, and the ones a request may ask for instead. The
# allocator never reads the node volume: this list is your statement about what is
# installed at /var/db/vif/wad/scenario, and a name that is not there fails the
# session's init container rather than starting a session that cannot load.
VIF_ALLOCATOR_SCENARIO=main
VIF_ALLOCATOR_SCENARIOS=main,blank
