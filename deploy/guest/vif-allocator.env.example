# Site values for vif-allocator.service. Install as
# /etc/vif-allocator/allocator.env and keep the image equal to an image listed by
# `sudo k3s crictl images`.
VIF_ALLOCATOR_LISTEN=:9080
VIF_ALLOCATOR_IMAGE=docker.io/library/vi-fighter:CHANGE_ME
VIF_ALLOCATOR_JOIN_HOST=lixen.com
VIF_ALLOCATOR_PAGE_BASE=https://lixen.com/projects/vi-fighter/session/
