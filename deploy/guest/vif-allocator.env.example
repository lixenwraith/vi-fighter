# Site values for vif-allocator.service. Install as
# /etc/vif-allocator/allocator.env and keep the image equal to an image listed by
# `sudo k3s crictl images`.
VIF_ALLOCATOR_LISTEN=:9080
VIF_ALLOCATOR_IMAGE=docker.io/library/vi-fighter:CHANGE_ME
VIF_ALLOCATOR_JOIN_HOST=CHANGE_ME
VIF_ALLOCATOR_PAGE_BASE=https://CHANGE_ME/projects/vi-fighter/session/
VIF_ALLOCATOR_LOG_STREAM_URL=http://127.0.0.1:8081/stream
# What a caller may select per session. The ceiling is the default roster until it is
# raised here; trace stays out of reach because the fleet's log rate and tmpfs are
# shared and an anonymous request must not raise either.
VIF_ALLOCATOR_PLAYERS_MAX=4
VIF_ALLOCATOR_LOG_LEVEL_MIN=debug
# The scenario every session gets, and the volume the rest are discovered in. What
# a request may choose is whatever scenario/ holds when it asks, so installing one
# is enough to offer it — there is no second list to keep in step. The default is
# offered even if the volume cannot be read.
#
# VIF_ALLOCATOR_WAD is the one optional variable here: unset means the path below,
# which is where update-vif-wad.sh installs. Set it only to serve from elsewhere.
VIF_ALLOCATOR_SCENARIO=main
VIF_ALLOCATOR_WAD=/var/db/vif/wad
# The browser path. Both or neither: the origin publishes /vif/ws/<session> and is
# the only Origin that route answers, and the bridge image is the sidecar that
# serves it from inside each session pod. Leave both empty for a fleet that only
# native clients reach.
VIF_ALLOCATOR_WEB_ORIGIN=https://CHANGE_ME
VIF_ALLOCATOR_WS_BRIDGE_IMAGE=docker.io/library/vif-ws-bridge:CHANGE_ME
# Concurrent browser connections one session carries. It is the per-player bound
# for browsers, because they all reach the pod from the same loopback address, and
# it sits above the roster rather than on it: a player whose connection dropped
# holds a slot until the pod notices, so a ceiling equal to the roster refuses the
# reconnect it is meant to allow.
VIF_ALLOCATOR_WEB_MAX=6
