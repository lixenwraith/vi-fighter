# The LogWisp sidecar image. Build with the LogWisp repository, not vi-fighter,
# as the context:
#
#   docker build -f /path/to/vi-fighter/deploy/docker/Dockerfile.logwisp \
#     -t logwisp:dev /path/to/logwisp
#
# The deployment baseline uses one pinned builder across both images. LogWisp's
# module currently accepts this newer toolchain; align its go directive in the
# separate repository before that repository's own container workflow is added.
ARG GO_VERSION=1.27.1

FROM docker.io/library/golang:${GO_VERSION}-alpine AS build

# Git supplies Go's VCS build information; only /out/logwisp crosses stages.
RUN apk add --no-cache git
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG REVISION=unknown
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath \
      -ldflags="-s -w -X logwisp/internal/version.Version=${VERSION} -X logwisp/internal/version.GitCommit=${REVISION}" \
      -o /out/logwisp ./cmd/logwisp

FROM scratch

ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE=https://github.com/lixenwraith/logwisp

LABEL org.opencontainers.image.title="logwisp" \
      org.opencontainers.image.description="LogWisp sidecar for Vi-Fighter session logs" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.licenses="BSD-3-Clause"

COPY --from=build /out/logwisp /logwisp

# Numeric identity is required in scratch and matches the restricted pod spec.
USER 65532:65532

# The configured HTTP sink serves SSE and status on this cluster-internal port.
EXPOSE 8080

ENTRYPOINT ["/logwisp"]
